{
  "manifestVersion": 2,
  "id": "flow",
  "name": "Orca Flow",
  "version": "0.2.30",
  "description": "What needs you next, room to run more, and coordinators that delegate to workers.",
  "engines": {
    "orca": ">=1.4.254"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "orca-flow",
        "title": "Orca Flow",
        "icon": "layers",
        "entry": "src/panel/index.html",
        "ui": "html"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      },
      {
        "on": "workspace.changed"
      }
    ],
    "commands": [
      {
        "id": "sidebar.next",
        "title": "Jump to next waiting workspace"
      },
      {
        "id": "flow.update",
        "title": "Update Orca Flow"
      }
    ],
    "statusBarItems": [
      {
        "id": "queue",
        "text": "…",
        "icon": "bell",
        "tooltip": "Workspaces waiting on you",
        "command": "sidebar.next"
      },
      {
        "id": "update",
        "text": "Orca Flow update",
        "icon": "download",
        "tooltip": "Update Orca Flow",
        "command": "flow.update"
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "agent:launch"
    }
  ]
}
